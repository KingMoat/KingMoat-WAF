[Unit]
Description=KingMoat WAF (all-in-one: data plane + console)
Documentation=https://github.com/kingmoat/kingmoat
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kingmoat
Group=kingmoat
# Non-root privileged-port binding: only CAP_NET_BIND_SERVICE is granted
# (for listen_http/listen_https on 80/443); no other capabilities survive.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# StateDirectory creates /var/lib/kingmoat with correct ownership and keeps it
# writable despite ProtectSystem=strict (config DB, audit logs, cert library,
# acme-cache all live there). ConfigurationDirectory covers /etc/kingmoat.
StateDirectory=kingmoat
ConfigurationDirectory=kingmoat
WorkingDirectory=/var/lib/kingmoat
# Console admin password hash (argon2id): generate with `kingmoat-cli hash-password -stdin`
# and drop it into /etc/kingmoat/env as KINGMOAT_ADMIN_HASH=...
# (optional: KINGMOAT_ADMIN_TOTP=<base32>, KINGMOAT_AI_API_KEY=<provider key>)
# If the hash is unset, console auth is still enforced: sign in with the
# bootstrap account kmadmin / KingMoat@2026 (password change forced at first login).
EnvironmentFile=-/etc/kingmoat/env
# Console port (CONSOLE_PORT): the in-console port change (settings page)
# rewrites this file and restarts the unit. Create it before first start:
#   echo CONSOLE_PORT=8443 | sudo tee /var/lib/kingmoat/console.env
#   sudo chmod 600 /var/lib/kingmoat/console.env
# If it is missing the unit fails to start (keep the dash prefix removed for
# fail-fast behavior; restore the value as shown above to recover).
EnvironmentFile=/var/lib/kingmoat/console.env
# -config            seed config, imported on first boot; live config lives in the console DB
# -console-addr      embedded console (Web UI + /api/* + /metrics); HTTPS by default
#                    (self-signed bootstrap cert; replace from the console settings);
#                    the port is expanded by systemd from the EnvironmentFile above
# -console-db        SQLite config store; keep on a LOCAL disk, never on NFS/SMB
ExecStart=/usr/local/bin/kingmoat -config /etc/kingmoat/config.json -console-addr 127.0.0.1:${CONSOLE_PORT} -console-db /var/lib/kingmoat/kingmoat.db
Restart=on-failure
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
